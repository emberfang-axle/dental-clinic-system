# Firebase project config (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email is sent via Firebase Cloud Functions using Resend (https://resend.com).
# Set this secret in Firebase Functions — NOT here:
#   firebase functions:secrets:set RESEND_API_KEY
# The FROM address used is: Estandarte Dental <noreply@estandartedental.com>
# Make sure that domain is verified in your Resend dashboard.
