rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }

    function uid() { return request.auth.uid; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      let doc = get(/databases/$(database)/documents/users/$(uid()));
      return doc.data.get('role', 'patient');
    }

    function isAdminOrDoctor() { return role() in ['admin', 'doctor']; }
    function isStaffOrAbove()  { return role() in ['admin', 'doctor', 'staff']; }

    // ── USERS ──────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read user list (needed for staff/doctor lookups)
      allow read: if authed();

      // Self-register as patient only
      allow create: if authed()
        && uid() == userId
        && request.resource.data.role == 'patient';

      // Own profile update (cannot change own role)
      allow update: if authed()
        && uid() == userId
        && request.resource.data.role == resource.data.role;

      // Admin/doctor can create or update any user
      allow create, update: if authed() && isAdminOrDoctor();
    }

    // ── APPOINTMENTS ───────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read: if authed() && (
        resource.data.patientId == uid() || isStaffOrAbove()
      );
      allow create: if authed() && (
        request.resource.data.patientId == uid() || isStaffOrAbove()
      );
      allow update: if authed() && (
        resource.data.patientId == uid() || isStaffOrAbove()
      );
      allow delete: if authed() && (
        resource.data.patientId == uid() || isAdminOrDoctor()
      );
    }

    // ── SERVICES (public read) ─────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if authed() && isAdminOrDoctor();
    }

    // ── SETTINGS ──────────────────────────────────────────
    match /settings/{docId} {
      allow read: if authed();
      allow write: if authed() && isAdminOrDoctor();
    }

    // ── NOTIFICATIONS ─────────────────────────────────────
    match /notifications/{notifId} {
      allow create: if authed();
      allow read, update, delete: if authed() && (
        resource.data.userId == uid() || isAdminOrDoctor()
      );
    }

    // ── ANNOUNCEMENTS ─────────────────────────────────────
    match /announcements/{id} {
      allow read: if true;
      allow write: if authed() && isAdminOrDoctor();
    }

    // ── FEEDBACK ──────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if authed();
      allow update, delete: if authed() && (
        resource.data.userId == uid() || isAdminOrDoctor()
      );
    }

    // ── AUDIT LOGS ────────────────────────────────────────
    match /logs/{logId} {
      allow read: if authed() && isAdminOrDoctor();
      allow create: if authed();
      allow update, delete: if false;
    }
  }
}
