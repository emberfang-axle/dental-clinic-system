rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // GCash payment screenshots — patient can upload/read their own appointment's folder
    match /gcash-screenshots/{appointmentId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Treatment photos — staff/doctor only
    match /treatment-photos/{appointmentId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
