rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function authed() { return request.auth != null; }

    // Treatment photos — only staff/doctor/admin can write; authenticated users can read
    match /treatment-photos/{appointmentId}/{fileName} {
      allow read:  if authed();
      allow write: if authed()
        && request.resource.size < 10 * 1024 * 1024  // max 10 MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
